# Primary BST database connection settings.
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Optional CA certificate path for SSL-enabled DB connections.
DB_SSL_CA=

# Optional full DB URL override for services that support URL-based config.
DB_URL=

# Optional dedicated RLM database URL. Falls back to DB_URL or the DB_* variables above.
RLM_DB_URL=

# Optional dedicated RLM database host override.
RLM_DB_HOST=

# Optional dedicated RLM database user override.
RLM_DB_USER=

# Optional dedicated RLM database password override.
RLM_DB_PASSWORD=

# Optional dedicated RLM database name override.
RLM_DB_NAME=

# Optional CA certificate path for the RLM DB connection.
RLM_DB_SSL_CA=

# Optional cookie used by the report sync helper.
PROTOCOL_COOKIE=

# Required for LLM-assisted RLM Assistant mode. Leave blank to keep deterministic-only behavior.
OPENAI_API_KEY=your-openai-api-key

# Default OpenAI model used when no assistant-specific override is set.
OPENAI_MODEL=gpt-4.1-mini

# Optional assistant-specific model override for the RLM Assistant planner/rewrite layer.
RLM_ASSISTANT_MODEL=

# Feature flag for LLM-assisted mode. Set to false to force deterministic-only behavior in the assistant.
RLM_ASSISTANT_ENABLE_LLM=false

# Optional custom OpenAI-compatible base URL. Leave blank to use the default OpenAI API endpoint.
OPENAI_BASE_URL=
